# Configuración de Supabase / Base de datos
# Copia este archivo como .env y completa con tus credenciales

# Motor de base de datos (opciones: sqlite, postgresql)
# Para desarrollo local usa sqlite; para Supabase usa postgresql
DB_ENGINE=sqlite

# Host de Supabase (reemplaza por el host real de tu proyecto)
# EJEMPLO DE FORMATO: db.abcd1234.supabase.co
# Encuéntralo en: Project Settings -> Database -> Connection Info
SUPABASE_DB_HOST=db.abcd1234.supabase.co

# Nombre de la base de datos (generalmente 'postgres')
SUPABASE_DB_NAME=postgres

# Usuario de la base de datos (generalmente 'postgres')
SUPABASE_DB_USER=postgres

# Contraseña de la base de datos (la que configuraste en Supabase)
SUPABASE_DB_PASSWORD=tu_password_aqui

# Puerto (generalmente 5432)
SUPABASE_DB_PORT=5432

# Configuración de Django
SECRET_KEY=tu_secret_key_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Configuración de CORS
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100,http://localhost:8101,http://127.0.0.1:8101,http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOW_ALL_ORIGINS=True

# Configuración de Supabase API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_KEY=tu_service_key_aqui

# Configuración de Email
DEFAULT_FROM_EMAIL=noreply@tudominio.com
FRONTEND_URL=http://localhost:8100

# Configuración SMTP para envío de emails reales
# Opciones: 'console' para desarrollo, 'smtp' para producción
EMAIL_MODE=console

# Configuración SMTP (descomenta y configura para usar emails reales)
# Para Gmail:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_email@gmail.com
# EMAIL_HOST_PASSWORD=tu_app_password

# Para SendGrid:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=tu_sendgrid_api_key

# Para Outlook/Hotmail:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_email@outlook.com
# EMAIL_HOST_PASSWORD=tu_password