@startuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "Usuarios (Django)" {
  class Usuario {
    email: EmailField
    username: CharField
    nombre: CharField
    apellido: CharField
    rol: CharField
    estado: CharField
    prestamos_activos: PositiveIntegerField
    max_prestamos_permitidos: PositiveIntegerField
    multas_pendientes: DecimalField
    sancionado_hasta: DateTimeField
  }

  class Estudiante {
    carrera: CharField
    matricula: CharField
    semestre_actual: PositiveIntegerField
    fecha_ingreso: DateField
  }

  class Docente {
    numero_empleado: CharField
    departamento: CharField
    especialidad: CharField
    tipo_contrato: CharField
  }

  class Administrador {
    area: CharField
    cargo: CharField
    nivel_acceso: PositiveIntegerField
    puede_gestionar_libros: BooleanField
    puede_gestionar_prestamos: BooleanField
  }

  class InvitacionRegistro {
    token: UUIDField
    email_invitado: EmailField
    rol_asignado: CharField
    estado: CharField
  }

  class NotificacionUsuarios {
    tipo: CharField
    titulo: CharField
    prioridad: CharField
    leida: BooleanField
  }

  class ConfiguracionNotificacion {
    prestamos_email: BooleanField
    prestamos_push: BooleanField
    multas_email: BooleanField
    multas_push: BooleanField
  }

  class RegistroAuditoria {
    accion: CharField
    nivel_riesgo: CharField
    exitosa: BooleanField
  }

  class SesionUsuario {
    session_key: CharField
    ip_address: GenericIPAddressField
    activa: BooleanField
  }

  class AccesoRecurso {
    recurso_tipo: CharField
    recurso_id: CharField
    tipo_acceso: CharField
  }

  class ConfiguracionAuditoria {
    dias_retencion_logs: PositiveIntegerField
    alertas_activas: BooleanField
  }
}

package "Libros (Django)" {
  class Libro {
    titulo: CharField
    autor: CharField
    isbn: CharField
    categoria: CharField
    estado: CharField
    cantidad_total: PositiveIntegerField
    cantidad_disponible: PositiveIntegerField
  }

  class Prestamo {
    estado: CharField
    fecha_prestamo: DateTimeField
    fecha_devolucion_esperada: DateField
    renovaciones: PositiveIntegerField
  }

  class Reserva {
    estado: CharField
    fecha_reserva: DateTimeField
    fecha_expiracion: DateTimeField
  }

  class Bibliografia {
    curso: CharField
    programa: CharField
    activa: BooleanField
    es_publica: BooleanField
  }

  class Sancion {
    tipo: CharField
    monto: DecimalField
    dias_suspension: PositiveIntegerField
    estado: CharField
  }

  class NotificacionLibros {
    tipo: CharField
    titulo: CharField
    leida: BooleanField
  }
}

package "Frontend (Angular)" {
  class IUsuario <<interface>> {
    email: string
    username: string
    nombre: string
    apellido: string
    rol: 'estudiante'|'docente'|'administrador'
  }

  class ILibro <<interface>> {
    titulo: string
    autor: string
    isbn: string
    categoria: string
    estado: 'Disponible'|'Prestado'|'Reservado'|'Mantenimiento'
    cantidad_total: number
    cantidad_disponible: number
  }

  class IPrestamo <<interface>> {
    estado: 'Pendiente'|'Activo'|'Devuelto'|'Vencido'|'Rechazado'
    fecha_prestamo: string
  }

  class IReserva <<interface>> {
    estado: 'Activa'|'Completada'|'Cancelada'
    fecha_reserva: string
  }

  class IBibliografia <<interface>> {
    curso: string
    programa: string
    es_publica: boolean
  }

  class ISancio <<interface>> {
    tipo: 'Multa'|'Suspensión'
    estado: 'Activa'|'Pagada'|'Completada'
  }
}

Estudiante "1" -- "1" Usuario : usuario
Docente "1" -- "1" Usuario : usuario
Administrador "1" -- "1" Usuario : usuario
Administrador "0..1" -- "0..*" Administrador : supervisor
InvitacionRegistro "1" -- "1" Usuario : creado_por
InvitacionRegistro "0..1" -- "1" Usuario : usuario_registrado
NotificacionUsuarios "1" -- "1" Usuario : usuario
ConfiguracionNotificacion "1" -- "1" Usuario : usuario
RegistroAuditoria "0..1" -- "1" Usuario : usuario
SesionUsuario "1" -- "1" Usuario : usuario
AccesoRecurso "1" -- "1" Usuario : usuario
ConfiguracionAuditoria "0..1" -- "1" Usuario : actualizada_por

Prestamo "1" -- "1" Libro : libro
Prestamo "1" -- "1" Usuario : usuario
Prestamo "0..1" -- "1" Usuario : aprobado_por
Reserva "1" -- "1" Libro : libro
Reserva "1" -- "1" Usuario : usuario
Bibliografia "1" -- "1" Usuario : docente
Bibliografia "*" -- "*" Libro : libros
Sancion "1" -- "1" Usuario : usuario
Sancion "0..1" -- "1" Prestamo : prestamo
NotificacionLibros "1" -- "1" Usuario : usuario

IUsuario .. Usuario
ILibro .. Libro
IPrestamo .. Prestamo
IReserva .. Reserva
IBibliografia .. Bibliografia
ISancio .. Sancion

@enduml
