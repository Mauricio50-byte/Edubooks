@startuml

title Edubooks - Arquitectura Cliente-Servidor

package "Cliente (Ionic Angular)" {
  [App Shell]
  [DashboardPage]
  [CatalogoPage]
  [PrestamosPage]
  [SancionesPage]
  [BibliografiaPage]
  [AjustesPage]

  [AuthService]
  [CatalogoService]
  [PrestamoService]
  [SancionService]
  [BibliografiaService]
  [NotificacionService]
  [Storage (Ionic Storage)]

  [App Shell] --> [DashboardPage]
  [App Shell] --> [CatalogoPage]
  [App Shell] --> [PrestamosPage]
  [App Shell] --> [SancionesPage]
  [App Shell] --> [BibliografiaPage]
  [App Shell] --> [AjustesPage]

  [DashboardPage] --> [AuthService]: sesión
  [CatalogoPage] --> [CatalogoService]: búsqueda/listado
  [PrestamosPage] --> [PrestamoService]: crear/renovar/devolver
  [SancionesPage] --> [SancionService]: listar/gestionar
  [BibliografiaPage] --> [BibliografiaService]: agregar/quitar
  [AjustesPage] --> [AuthService]: perfil/cerrar sesión

  [AuthService] --> [Storage (Ionic Storage)]: guardar token
  [CatalogoService] --> [AuthService]: token
  [PrestamoService] --> [AuthService]: token
  [SancionService] --> [AuthService]: token
  [BibliografiaService] --> [AuthService]: token
  [NotificacionService] --> [AuthService]: token
}

package "Servidor (Supabase/Edge)" {
  node "API Edge Functions" as EdgeAPI
  component "Auth" as AuthSrv
  database "Postgres" as DB
  component "Storage Buckets" as Bucket

  [Tabla Catalogo]
  [Tabla Prestamos]
  [Tabla Sanciones]
  [Tabla Bibliografia]
  [Tabla Reservas]
  [Tabla Usuarios]
  [Tabla Notificaciones]

  EdgeAPI --> DB: SQL CRUD
  EdgeAPI --> Bucket: archivos
  AuthSrv --> DB: perfiles

  DB --> [Tabla Catalogo]
  DB --> [Tabla Prestamos]
  DB --> [Tabla Sanciones]
  DB --> [Tabla Bibliografia]
  DB --> [Tabla Reservas]
  DB --> [Tabla Usuarios]
  DB --> [Tabla Notificaciones]
}

package "Servicios Externos" {
  component "Proveedor Email (SMTP)" as EmailProv
}

[AuthService] --> AuthSrv: HTTPS/REST
[CatalogoService] --> EdgeAPI: HTTPS/REST GET /catalogo
[PrestamoService] --> EdgeAPI: HTTPS/REST POST /prestamos
[PrestamoService] --> EdgeAPI: HTTPS/REST POST /renovaciones
[PrestamoService] --> EdgeAPI: HTTPS/REST POST /devoluciones
[SancionService] --> EdgeAPI: HTTPS/REST GET/POST /sanciones
[BibliografiaService] --> EdgeAPI: HTTPS/REST POST /bibliografia
[NotificacionService] --> EdgeAPI: HTTPS/REST POST /notificaciones

EdgeAPI --> EmailProv: SMTP enviar correo
EdgeAPI --> AuthSrv: validación token

note right of EdgeAPI
Flujos: búsqueda, préstamo, renovación, devolución, sanción, bibliografía
end note

note bottom of EmailProv
Entrega de emails de notificación a usuarios
end note

legend left
Cliente: App Ionic Angular (páginas y servicios)
Servidor: Supabase (Auth, Postgres, Buckets, Edge Functions)
Externo: Proveedor de Email (SMTP)
Protocolos: HTTPS/REST, SQL, SMTP
end legend

@enduml
